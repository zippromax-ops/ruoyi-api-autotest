# 使用方法：复制本文件为 .env，填入真实环境信息后运行测试。
# .env 已被 .gitignore 忽略，不会提交到代码仓库。
# 请勿把真实 IP、账号、密码等敏感信息写入仓库内的其他文件。

# 接口基础地址（nginx 已配置 /dev-api 前缀转发到后端；如直连后端则不带 /dev-api 前缀）
RUOYI_BASE_URL=http://<服务器IP>/dev-api

# 管理员账号（用于登录获取 token）
RUOYI_ADMIN_USER=<管理员账号>
RUOYI_ADMIN_PWD=<管理员密码>

# 请求超时（秒）
RUOYI_TIMEOUT=15

# 数据库配置（用于登录日志等校验）
RUOYI_DB_HOST=<数据库IP>
RUOYI_DB_PORT=3306
RUOYI_DB_USER=<数据库账号>
RUOYI_DB_PASSWORD=<数据库密码>
RUOYI_DB_NAME=<数据库名>
RUOYI_DB_CHARSET=utf8mb4
RUOYI_DB_CONNECT_TIMEOUT=5
